<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/demo_subtitle"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_benchmark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_benchmark" />

    <Button
        android:id="@+id/btn_simple_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_simple_layout"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btn_nested_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_nested_layout"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btn_scroll_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_scroll_layout"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/status_loading"
        android:layout_marginTop="24dp" />

</LinearLayout>
