<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/demo_text_primary" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/demo_subtitle"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btn_benchmark"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/btn_benchmark"
        android:elevation="2dp" />

    <Button
        android:id="@+id/btn_code_viewer"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/btn_code_viewer"
        android:layout_marginTop="12dp"
        android:elevation="2dp" />

    <TextView
        android:id="@+id/registry_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/status_loading"
        android:textSize="12sp"
        android:layout_marginTop="32dp" />

</LinearLayout>
