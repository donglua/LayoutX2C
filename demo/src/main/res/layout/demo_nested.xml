<?xml version="1.0" encoding="utf-8"?>
<!-- demo_nested: 嵌套结构（LinearLayout weight + FrameLayout），用于演示 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Header row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/nested_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/demo_nested_label"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/nested_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/demo_nested_badge"
            android:padding="4dp"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Content frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nested_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/demo_nested_content"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/nested_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/demo_nested_detail"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
