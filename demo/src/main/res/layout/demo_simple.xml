<?xml version="1.0" encoding="utf-8"?>
<!-- demo_simple: 单层 LinearLayout，用于 Benchmark + Code Viewer 演示 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/demo_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/demo_simple_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/demo_text_primary"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/demo_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/demo_simple_body"
        android:textSize="14sp"
        android:layout_marginBottom="12dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FFE0E0E0" />

</LinearLayout>
