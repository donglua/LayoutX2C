<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="@string/code_viewer_layout_label"
                android:textColor="@color/code_viewer_muted_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_demo_simple"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/code_viewer_chip"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/code_viewer_simple"
                android:textAllCaps="false"
                android:textColor="@color/code_viewer_chip_text_selector" />

            <Button
                android:id="@+id/btn_demo_nested"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/code_viewer_chip"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/code_viewer_nested"
                android:textAllCaps="false"
                android:textColor="@color/code_viewer_chip_text_selector" />

            <Button
                android:id="@+id/btn_demo_form"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/code_viewer_chip"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/code_viewer_form"
                android:textAllCaps="false"
                android:textColor="@color/code_viewer_chip_text_selector" />

            <Button
                android:id="@+id/btn_demo_relative"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/code_viewer_chip"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/code_viewer_relative"
                android:textAllCaps="false"
                android:textColor="@color/code_viewer_chip_text_selector" />

            <Button
                android:id="@+id/btn_demo_recycler"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/code_viewer_chip"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/code_viewer_recycler"
                android:textAllCaps="false"
                android:textColor="@color/code_viewer_chip_text_selector" />

        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <Button
            android:id="@+id/tab_xml"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/code_viewer_tab"
            android:minHeight="0dp"
            android:text="@string/code_viewer_tab_xml"
            android:textAllCaps="false"
            android:textColor="@color/code_viewer_tab_text_selector" />

        <Button
            android:id="@+id/tab_kotlin"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/code_viewer_tab"
            android:minHeight="0dp"
            android:text="@string/code_viewer_tab_kotlin"
            android:textAllCaps="false"
            android:textColor="@color/code_viewer_tab_text_selector" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel_xml"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:layout_weight="1"
        android:background="@drawable/code_viewer_panel"
        android:orientation="vertical">

        <include layout="@layout/include_code_panel_xml" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel_kotlin"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:layout_weight="1"
        android:background="@drawable/code_viewer_panel"
        android:orientation="vertical"
        android:visibility="gone">

        <include layout="@layout/include_code_panel_kotlin" />
    </LinearLayout>

</LinearLayout>
