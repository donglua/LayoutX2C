<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Toolbar area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/benchmark_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/benchmark_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/demo_text_primary" />

        <Button
            android:id="@+id/btn_run"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/benchmark_run"
            android:elevation="1dp" />

    </LinearLayout>

    <!-- Scrollable results area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <TextView
            android:id="@+id/benchmark_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/benchmark_idle"
            android:textSize="13sp"
            android:padding="16dp"
            android:lineSpacingExtra="4dp" />

    </ScrollView>

</LinearLayout>
