<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/demo_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/demo_scroll_image_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_demo_scroll_image"
            android:scaleType="centerInside"
            android:tint="@color/demo_image_tint" />

        <TextView
            android:id="@+id/demo_scroll_image_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/demo_scroll_image_title"
            android:textColor="@color/demo_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/demo_scroll_image_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/demo_scroll_image_body"
            android:textColor="@color/code_viewer_muted_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/demo_scroll_image_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@color/demo_surface_variant"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/demo_scroll_image_caption"
            android:textColor="@color/demo_text_primary"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
