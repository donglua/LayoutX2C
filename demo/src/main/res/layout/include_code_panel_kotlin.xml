<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/code_viewer_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/title_kotlin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="@color/demo_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/summary_kotlin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/code_viewer_muted_text"
            android:textSize="12sp" />

    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/code_hscroll_kotlin"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <ScrollView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/code_viewer_code_background"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/line_numbers_kotlin"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/code_viewer_gutter"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:paddingStart="8dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="14dp"
                    android:textColor="@color/code_viewer_gutter_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/code_kotlin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:paddingStart="14dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="14dp"
                    android:scrollHorizontally="true"
                    android:textColor="@color/demo_text_primary"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />

            </LinearLayout>
        </ScrollView>
    </HorizontalScrollView>
</merge>
